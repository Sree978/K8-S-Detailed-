and write our own manifest files

vim.yml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: devops
  annotations:
    cause: "this is cycle website"
spec:
  replicas: 2
  selector:
    matchLabels:
      app: ccit
  template:
    metadata:
      labels:
        app: ccit
    spec:
      containers:
      - name: cont
        image: shaikmustafa/cycle
        ports:
        - containerPort: 80

install metric server before run HPA

kubectl apply -f https://github.com/kubernetes-sigs/metrics-server/releases/latest/download/components.yaml

vim hpa.yml

apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: myhpa
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: devops
  minReplicas: 3
  maxReplicas: 6
  metrics:
  - type: Resource
    resource:
      name: cpu
      target:
        type: Utilization
        averageUtilization: 60

write service manifest file 
 vim svc.yml
apiVersion: v1
kind: Service
metadata:
  name: mysvc
spec:
  type: LoadBalancer
  selector:
    app: ccit
  ports:
    - port: 80
      targetPort: 80
