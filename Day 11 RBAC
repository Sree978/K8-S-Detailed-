apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: mustafa-role
  namespace: dev

rules:
- apiGroups: ["*"]
  resources: ["pods", "deployments"]
  verbs: ["get", "list", "watch", "create"]

- apiGroups: ["*"]
  resources: ["secrets"]
  verbs: ["get", "list", "create", "delete"].yml

